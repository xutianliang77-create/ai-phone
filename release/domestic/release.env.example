# Domestic production release env template.
# Copy to a private env file and replace every placeholder with reviewed values.

REGION_EDITION=domestic
DATA_REGION=cn
COMPLIANCE_PROFILE=pipl
NODE_ENV=production
MOBILE_RELEASE_COMPANY_NAME=北京乾坤祥云科技有限公司

API_BASE_URL=https://api.example.cn
INTERNAL_API_SECRET=replace-with-internal-api-secret
AUTH_OTP_SECRET=replace-with-strong-auth-otp-secret
AUTH_DEBUG_OTP=false
API_TEST_AUTO_ACCOUNT=false
PUBLIC_CALL_BASE_URL=https://call.example.cn
REALTIME_PROVIDER=hymt2_self_hosted
TRANSLATION_PROVIDER=hymt2_self_hosted
TRANSLATION_BASE_URL=https://translation.example.cn/v1
TRANSLATION_MODEL=tencent/Hy-MT2-1.8B
TRANSLATION_API_KEY=replace-with-hymt2-translation-api-key
TRANSLATION_SERVICE_API_KEY=replace-with-hymt2-translation-api-key
TRANSLATION_TIMEOUT_MS=5000
TRANSLATION_MAX_TOKENS=512
ASR_HTTP_ENDPOINT=https://asr.example.cn/asr/transcribe
ASR_HTTP_FLUSH_ENDPOINT=https://asr.example.cn/asr/sessions/:sessionId/flush
ASR_HTTP_API_KEY=replace-with-asr-service-api-key
ASR_SERVICE_API_KEY=replace-with-asr-service-api-key
# Optional commercial quality fallback; not required by domestic release gates.
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_API_KEY=replace-with-optional-qwen-api-key
TTS_PROVIDER=voxcpm2
TTS_MODEL=VoxCPM2
TTS_HTTP_ENDPOINT=https://tts.example.cn/voxcpm2/synthesize
TTS_HTTP_API_KEY=replace-with-voxcpm2-tts-api-key
TTS_SERVICE_API_KEY=replace-with-voxcpm2-tts-api-key
TTS_HTTP_TIMEOUT_MS=5000
TTS_VOICE_REFERENCE_DIR=/data/ai-phone/voice-references
# Optional Worker-side default voice simulation route:
# TTS_VOICE_MODE=preset|voice_design|personal_clone|ultimate_clone
# TTS_VOICE_PROFILE_ID=my_voice
# TTS_VOICE_REFERENCE_AUDIO_ID=my_voice
# TTS_VOICE_REFERENCE_TRANSCRIPT=reference audio transcript for ultimate_clone
# TTS_VOICE_CONTROL_PROMPT=clear and calm

SMS_PROVIDER=http
SMS_HTTP_ENDPOINT=https://sms.example.cn/send
SMS_HTTP_API_KEY=replace-with-sms-api-key
SMS_HTTP_TEMPLATE_ID=replace-with-login-template-id
SMS_SIGN_NAME=ai phone
SMS_HTTP_TIMEOUT_MS=5000

CALL_ROOM_PROVIDER=livekit
LIVEKIT_URL=wss://livekit.example.cn
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret
CALL_ROOM_TOKEN_TTL_SECONDS=3600

PAYMENT_REQUIRED_PROVIDERS=apple_iap,wechat_pay,alipay
PAYMENT_CALLBACK_BASE_URL=https://api.example.cn
APPLE_IAP_BUNDLE_ID=cn.qkxy.realtimeinterpreter
APPLE_IAP_ENVIRONMENT=Production
APPLE_IAP_ROOT_CERT_SHA256=replace-with-apple-root-cert-sha256
WECHAT_PAY_APP_ID=replace-with-wechat-app-id
WECHAT_PAY_MCH_ID=replace-with-wechat-mch-id
WECHAT_PAY_WEBHOOK_SECRET=replace-with-wechat-webhook-secret
ALIPAY_APP_ID=replace-with-alipay-app-id
ALIPAY_MERCHANT_ID=replace-with-alipay-merchant-id
ALIPAY_WEBHOOK_SECRET=replace-with-alipay-webhook-secret

DIAGNOSTICS_ADMIN_TOKEN=replace-with-diagnostics-admin-token
DIAGNOSTICS_ONCALL_CONTACT=ops@qkxy.cn
DIAGNOSTICS_ALERT_WINDOW_MINUTES=15
DIAGNOSTICS_FATAL_ALERT_THRESHOLD=1
DIAGNOSTICS_ALERT_WEBHOOK_URL=https://ops.example.cn/alerts
DIAGNOSTICS_ALERT_WEBHOOK_SECRET=replace-with-diagnostics-alert-secret
DIAGNOSTICS_ALERT_WEBHOOK_TIMEOUT_MS=5000
DIAGNOSTICS_ALERT_WEBHOOK_FORMAT=generic

RELEASE_MATERIALS_FILE=release/domestic/release-materials.json
MODEL_SELECTION_FILE=release/domestic/model-selection-report.json
MODEL_ROUTING_FILE=release/domestic/model-routing.json
MODEL_ROUTING_PROFILE=domestic_server_qwen3_hymt2_voxcpm2

PSTN_BRIDGE_BASE_URL=https://pstn-bridge.example.cn
PSTN_BRIDGE_PORT=3302
PSTN_BRIDGE_API_KEY=replace-with-pstn-bridge-api-key
PSTN_BRIDGE_PROVIDER=fonoster
PSTN_BRIDGE_FONOSTER_BASE_URL=https://fonoster.example.cn
PSTN_BRIDGE_FONOSTER_ACCESS_KEY_ID=replace-with-fonoster-access-key-id
PSTN_BRIDGE_FONOSTER_API_KEY=replace-with-fonoster-api-key
PSTN_BRIDGE_FONOSTER_API_SECRET=replace-with-fonoster-api-secret
PSTN_BRIDGE_FONOSTER_APP_REF=replace-with-fonoster-app-ref
PSTN_BRIDGE_FONOSTER_FROM_NUMBER=replace-with-caller-number
PSTN_BRIDGE_FONOSTER_CALL_TIMEOUT_SECONDS=60
PSTN_BRIDGE_MEDIA_WRITER_ENDPOINT=https://pstn-bridge.example.cn/media-writer
PSTN_BRIDGE_MEDIA_WRITER_API_KEY=replace-with-media-writer-api-key
PSTN_BRIDGE_STATUS_WEBHOOK_ENDPOINT=https://api.example.cn/webhooks/pstn/agent-calls
PSTN_BRIDGE_STATUS_WEBHOOK_SECRET=replace-with-status-webhook-secret
PSTN_BRIDGE_AUDIO_FRAME_SINK_ENDPOINT=https://worker.example.cn/pstn/audio-frames
PSTN_BRIDGE_AUDIO_FRAME_SINK_API_KEY=replace-with-audio-frame-sink-api-key
PSTN_BRIDGE_PROVIDER_WEBHOOK_SECRET=replace-with-provider-webhook-secret
PSTN_RECORDING_DISCLOSURE_ENABLED=true
