# Domestic production release env template.
# Copy to a private env file and replace every placeholder with reviewed values.

REGION_EDITION=domestic
DATA_REGION=cn
COMPLIANCE_PROFILE=pipl
NODE_ENV=production
MOBILE_RELEASE_COMPANY_NAME=北京乾坤祥云科技有限公司

API_BASE_URL=https://api.example.cn
INTERNAL_API_SECRET=replace-with-internal-api-secret
AGENT_CALL_WORKER_ENABLED=false
AGENT_CALL_WORKER_ID=
AGENT_CALL_PROVIDER_ADAPTER=livekit_sip
AGENT_CALL_WORKER_LEASE_SECONDS=45
AGENT_CALL_RECONCILIATION_TIMEOUT_SECONDS=7200
PSTN_PROVIDER_IDEMPOTENCY_GUARANTEED=true
AUTH_OTP_SECRET=replace-with-strong-auth-otp-secret
AUTH_DEBUG_OTP=false
API_TEST_AUTO_ACCOUNT=false
PUBLIC_CALL_BASE_URL=https://call.example.cn
VOICE_AGENT_ENABLED=true
VOICE_AGENT_ASSIST_ENABLED=true
# Autonomous stays off until Assist acceptance and a reviewed user allowlist.
VOICE_AGENT_AUTONOMOUS_ENABLED=false
VOICE_AGENT_AUTONOMOUS_USER_IDS=
VOICE_AGENT_AUTONOMOUS_SCENARIOS=booking,customer_support,business_inquiry
VOICE_AGENT_POLICY_VERSION=voice-agent-v1
VOICE_AGENT_LLM_BASE_URL=https://llm.example.cn/v1
VOICE_AGENT_LLM_API_KEY=replace-with-voice-agent-llm-key
VOICE_AGENT_LLM_MODEL=qwen/qwen3.5-9b
VOICE_AGENT_LLM_TIMEOUT_MS=5000
VOICE_AGENT_RUNTIME_PROVIDER=disabled
LIVEKIT_VOICE_AGENT_NAME=voice-agent-runtime
VOICE_AGENT_DISPATCH_TICKET_SECRET=replace-with-separate-random-secret-at-least-32-bytes
VOICE_AGENT_DISPATCH_MAX_ACTIVE_JOBS=2
VOICE_AGENT_DISPATCH_LEASE_SECONDS=45
VOICE_AGENT_DISPATCH_HEARTBEAT_SECONDS=15
VOICE_AGENT_DISPATCH_READY_TIMEOUT_SECONDS=25
VOICE_AGENT_DISPATCH_REQUEST_TIMEOUT_SECONDS=10
VOICE_AGENT_MAX_JOBS_PER_NODE=2
VOICE_AGENT_IDLE_PROCESSES=1
VOICE_AGENT_DRAIN_TIMEOUT_SECONDS=90
VOICE_AGENT_SHUTDOWN_TIMEOUT_SECONDS=45
VOICE_AGENT_INITIALIZE_TIMEOUT_SECONDS=30
VOICE_AGENT_JOB_MEMORY_WARN_MB=768
VOICE_AGENT_JOB_MEMORY_LIMIT_MB=1024
VOICE_AGENT_PORT=8082
VOICE_AGENT_API_TIMEOUT_MS=10000
VOICE_AGENT_STT_MODEL=replace-with-reviewed-stt-model
VOICE_AGENT_TTS_MODEL=replace-with-reviewed-tts-model
VOICE_AGENT_TTS_VOICE=replace-with-reviewed-voice
VOICE_AGENT_INFERENCE_URL=https://inference.example.cn
LIVEKIT_INFERENCE_API_KEY=replace-with-inference-key
LIVEKIT_INFERENCE_API_SECRET=replace-with-inference-secret
VOICE_AGENT_AMD_MODEL=
VOICE_AGENT_AMD_NO_SPEECH_TIMEOUT_MS=12000
VOICE_AGENT_AMD_DETECTION_TIMEOUT_MS=30000
VOICE_AGENT_VOICEMAIL_ENABLED=false
VOICE_AGENT_DISCLOSURE_TEXT_ZH=您好，我是经用户授权代为致电的AI助手，本次通话用于完成已授权事项。
VOICE_AGENT_DISCLOSURE_TEXT_EN=Hello, I am an AI assistant calling with the user's authorization for an approved task.
VOICE_AGENT_MAX_SESSION_SECONDS=7200
VOICE_AGENT_HANDOFF_TIMEOUT_SECONDS=120
# Keep off until the isolated consult-room and allowlisted SIP trunk gates pass.
VOICE_AGENT_OPERATOR_CONSULT_ENABLED=false
VOICE_AGENT_OPERATOR_CONSULT_TTL_SECONDS=180
VOICE_AGENT_OPERATOR_CONSULT_MAX_ATTEMPTS=3
POSTGRES_PROJECTION_ENABLED=true
POSTGRES_PROJECTION_REQUIRED=true
POSTGRES_URL=postgresql://ai_phone:replace-with-password@postgres.example.cn:5432/ai_phone
POSTGRES_SSL_MODE=verify-full
POSTGRES_SSL_ROOT_CERT_FILE=/run/secrets/postgres-ca.pem
POSTGRES_PROJECTION_BATCH_SIZE=50
POSTGRES_PROJECTION_POLL_INTERVAL_MS=1000
POSTGRES_STATEMENT_TIMEOUT_MS=10000

# Release remains single-node until the PostgreSQL primary and HA gates are verified.
PLATFORM_MULTI_NODE_ENABLED=false
PLATFORM_REGION=cn-release-candidate
PLATFORM_CELL_ID=single-node-candidate
PLATFORM_INSTANCE_ID=
PLATFORM_ROUTING_GENERATION=1
PLATFORM_ACCEPT_NEW_SESSIONS=true
PLATFORM_SESSION_PLACEMENT=home_region_sticky
PLATFORM_TOPOLOGY_STATUS=candidate_unverified
PLATFORM_TARGET_CONCURRENT_SESSIONS=100
REALTIME_PROVIDER=hymt2_self_hosted
TRANSLATION_PROVIDER=hymt2_self_hosted
TRANSLATION_BASE_URL=https://translation.example.cn/v1
TRANSLATION_MODEL=tencent/Hy-MT2-1.8B
TRANSLATION_API_KEY=replace-with-hymt2-translation-api-key
TRANSLATION_SERVICE_API_KEY=replace-with-hymt2-translation-api-key
TRANSLATION_TIMEOUT_MS=5000
TRANSLATION_MAX_TOKENS=512
ASR_HTTP_ENDPOINT=https://asr.example.cn/asr/transcribe
ASR_HTTP_FLUSH_ENDPOINT=https://asr.example.cn/asr/sessions/:sessionId/flush
ASR_HTTP_API_KEY=replace-with-asr-service-api-key
ASR_SERVICE_API_KEY=replace-with-asr-service-api-key
# Optional commercial quality fallback; not required by domestic release gates.
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_API_KEY=replace-with-optional-qwen-api-key
TTS_PROVIDER=voxcpm2
TTS_MODEL=VoxCPM2
TTS_HTTP_ENDPOINT=https://tts.example.cn/voxcpm2/synthesize
TTS_HTTP_API_KEY=replace-with-voxcpm2-tts-api-key
TTS_SERVICE_API_KEY=replace-with-voxcpm2-tts-api-key
TTS_HTTP_TIMEOUT_MS=5000
TTS_VOICE_REFERENCE_DIR=/data/ai-phone/voice-references
# Optional Worker-side default voice simulation route:
# TTS_VOICE_MODE=preset|voice_design|personal_clone|ultimate_clone
# TTS_VOICE_PROFILE_ID=my_voice
# TTS_VOICE_REFERENCE_AUDIO_ID=my_voice
# TTS_VOICE_REFERENCE_TRANSCRIPT=reference audio transcript for ultimate_clone
# TTS_VOICE_CONTROL_PROMPT=clear and calm

SMS_PROVIDER=http
SMS_HTTP_ENDPOINT=https://sms.example.cn/send
SMS_HTTP_API_KEY=replace-with-sms-api-key
SMS_HTTP_TEMPLATE_ID=replace-with-login-template-id
SMS_SIGN_NAME=ai phone
SMS_HTTP_TIMEOUT_MS=5000

CALL_ROOM_PROVIDER=livekit
LIVEKIT_URL=wss://livekit.example.cn
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret
TRANSLATION_WORKER_RUNTIME_PROVIDER=livekit_dispatch
LIVEKIT_DISPATCH_TICKET_SECRET=replace-with-random-secret-at-least-32-bytes
LIVEKIT_TRANSLATION_AGENT_NAME=translation-runtime
LIVEKIT_DISPATCH_MAX_ACTIVE_JOBS=4
LIVEKIT_DISPATCH_LEASE_SECONDS=45
LIVEKIT_DISPATCH_HEARTBEAT_SECONDS=15
LIVEKIT_DISPATCH_READY_TIMEOUT_SECONDS=20
LIVEKIT_DISPATCH_REQUEST_TIMEOUT_SECONDS=10
LIVEKIT_DISPATCH_MAX_METADATA_BYTES=2048
TRANSLATION_WORKER_AUDIO_INGEST_MAX_FRAMES=20
LIVEKIT_AGENT_MAX_JOBS_PER_NODE=4
LIVEKIT_AGENT_IDLE_PROCESSES=2
LIVEKIT_AGENT_DRAIN_TIMEOUT_SECONDS=60
LIVEKIT_AGENT_SHUTDOWN_TIMEOUT_SECONDS=30
LIVEKIT_AGENT_INITIALIZE_TIMEOUT_SECONDS=20
LIVEKIT_AGENT_JOB_MEMORY_WARN_MB=768
LIVEKIT_AGENT_JOB_MEMORY_LIMIT_MB=1024
LIVEKIT_AGENT_PORT=8081
LIVEKIT_EGRESS_ENABLED=true
LIVEKIT_EGRESS_REQUEST_TIMEOUT_SECONDS=10
LIVEKIT_EGRESS_S3_BUCKET=replace-with-recording-bucket
LIVEKIT_EGRESS_S3_REGION=cn-north-1
LIVEKIT_EGRESS_S3_ENDPOINT=https://s3.example.cn
LIVEKIT_EGRESS_S3_ACCESS_KEY=replace-with-egress-storage-access-key
LIVEKIT_EGRESS_S3_SECRET_KEY=replace-with-egress-storage-secret
LIVEKIT_EGRESS_S3_FORCE_PATH_STYLE=false
LIVEKIT_EGRESS_S3_SSE=aws:kms
LIVEKIT_EGRESS_S3_KMS_KEY_ID=replace-with-egress-kms-key-id
LIVEKIT_EGRESS_OBJECT_PREFIX=recordings
LIVEKIT_EGRESS_MAX_RETENTION_DAYS=30
LIVEKIT_EGRESS_ARTIFACT_WORKER_ENABLED=true
LIVEKIT_EGRESS_ARTIFACT_BATCH_SIZE=4
LIVEKIT_EGRESS_ARTIFACT_RECOVERY_INTERVAL_SECONDS=60
# Ingress is enterprise-only and remains disabled until its independent pool is accepted.
LIVEKIT_INGRESS_ENABLED=false
LIVEKIT_INGRESS_REQUEST_TIMEOUT_SECONDS=10
LIVEKIT_INGRESS_MAX_ACTIVE_PER_SESSION=1
LIVEKIT_INGRESS_MAX_ACTIVE_TOTAL=8
LIVEKIT_INGRESS_POLICY_VERSION=external-media-v1
LIVEKIT_INGRESS_URL_INPUT_ENABLED=false
LIVEKIT_INGRESS_PULL_URL_HOSTS=media.example.cn
LIVEKIT_INGRESS_PULL_NETWORK_POLICY_ENFORCED=false
LIVEKIT_INGRESS_SOURCE_PREFLIGHT_TIMEOUT_MS=3000
LIVEKIT_INGRESS_SOURCE_MAX_REDIRECTS=2
LIVEKIT_INGRESS_SRT_ENABLED=false
SRT_INGRESS_BRIDGE_BASE_URL=http://127.0.0.1:3310
SRT_INGRESS_BRIDGE_API_KEY=replace-with-separate-srt-bridge-secret
SRT_INGRESS_PUBLIC_HOST=srt.example.cn
SRT_INGRESS_PORT=3310
SRT_INGRESS_PORT_MIN=10080
SRT_INGRESS_PORT_MAX=10179
SRT_INGRESS_MAX_JOBS=4
SRT_INGRESS_LATENCY_MS=200
SRT_INGRESS_MAX_DURATION_SECONDS=7200
SRT_INGRESS_SHUTDOWN_GRACE_MS=10000
SRT_INGRESS_RTMP_ALLOWED_HOSTS=ingress.example.cn
SRT_INGRESS_FFMPEG_PATH=/usr/bin/ffmpeg
CALL_ROOM_TOKEN_TTL_SECONDS=120
CALL_GUEST_TICKET_TTL_SECONDS=300
CALL_ROOM_MAX_PARTICIPANTS=3
CALL_ROOM_MAX_SESSION_SECONDS=3600
CALL_ROOM_EMPTY_TIMEOUT_SECONDS=300
CALL_ROOM_MAX_DATA_PACKET_BYTES=12288
CALL_ROOM_MAX_EVENTS_PER_REQUEST=20
CALL_ROOM_MAX_EVENT_REQUESTS_PER_SECOND=40
CALL_ROOM_MAX_PARTICIPANT_NAME_CHARACTERS=80
OTEL_ENABLED=true
OTEL_REQUIRED=true
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://otel.example.cn/v1/traces
OTEL_EXPORTER_OTLP_HEADERS=authorization=replace-with-collector-token
OTEL_TRACE_SAMPLE_RATIO=0.1
OTEL_BSP_MAX_QUEUE_SIZE=2048
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512
OTEL_BSP_SCHEDULE_DELAY_MS=5000
OTEL_BSP_EXPORT_TIMEOUT_MS=10000

# Do not apply this policy until staging and whitelist acceptance pass.
CALL_PROVIDER_POLICY=pstn_enabled
PSTN_PROVIDER=livekit_sip
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=replace-with-livekit-outbound-trunk-id
LIVEKIT_SIP_INBOUND_ENABLED=false
LIVEKIT_SIP_INBOUND_TRUNK_ID=
LIVEKIT_SIP_INBOUND_DEDICATED_TRUNK=false
LIVEKIT_SIP_INBOUND_DISPLAY_NUMBER=
LIVEKIT_WEBHOOK_URL=https://api.example.cn/webhooks/livekit
LIVEKIT_SIP_RINGING_TIMEOUT_SECONDS=45
LIVEKIT_SIP_REQUEST_TIMEOUT_SECONDS=10
LIVEKIT_SIP_RECONCILIATION_GRACE_SECONDS=30
LIVEKIT_SIP_MEDIA_ROUTING_MODE=blocked_pending_media_isolation
PSTN_CONSENT_PROMPT_VERSION=livekit-sip-v1
PSTN_MAX_CALL_MINUTES=60
PSTN_RECORDING_DISCLOSURE_ENABLED=true

PAYMENT_REQUIRED_PROVIDERS=apple_iap,wechat_pay,alipay
PAYMENT_CALLBACK_BASE_URL=https://api.example.cn
APPLE_IAP_BUNDLE_ID=cn.qkxy.realtimeinterpreter
APPLE_IAP_ENVIRONMENT=Production
APPLE_IAP_ROOT_CERT_SHA256=replace-with-apple-root-cert-sha256
WECHAT_PAY_APP_ID=replace-with-wechat-app-id
WECHAT_PAY_MCH_ID=replace-with-wechat-mch-id
WECHAT_PAY_WEBHOOK_SECRET=replace-with-wechat-webhook-secret
ALIPAY_APP_ID=replace-with-alipay-app-id
ALIPAY_MERCHANT_ID=replace-with-alipay-merchant-id
ALIPAY_WEBHOOK_SECRET=replace-with-alipay-webhook-secret

DIAGNOSTICS_ADMIN_TOKEN=replace-with-diagnostics-admin-token
DIAGNOSTICS_ONCALL_CONTACT=ops@qkxy.cn
DIAGNOSTICS_ALERT_WINDOW_MINUTES=15
DIAGNOSTICS_FATAL_ALERT_THRESHOLD=1
DIAGNOSTICS_ALERT_WEBHOOK_URL=https://ops.example.cn/alerts
DIAGNOSTICS_ALERT_WEBHOOK_SECRET=replace-with-diagnostics-alert-secret
DIAGNOSTICS_ALERT_WEBHOOK_TIMEOUT_MS=5000
DIAGNOSTICS_ALERT_WEBHOOK_FORMAT=generic

RELEASE_MATERIALS_FILE=release/domestic/release-materials.json
MODEL_SELECTION_FILE=release/domestic/model-selection-report.json
MODEL_ROUTING_FILE=release/domestic/model-routing.json
MODEL_ROUTING_PROFILE=domestic_server_qwen3_hymt2_voxcpm2

PSTN_BRIDGE_BASE_URL=https://pstn-bridge.example.cn
PSTN_BRIDGE_PORT=3302
PSTN_BRIDGE_API_KEY=replace-with-pstn-bridge-api-key
PSTN_BRIDGE_PROVIDER=fonoster
PSTN_BRIDGE_FONOSTER_BASE_URL=https://fonoster.example.cn
PSTN_BRIDGE_FONOSTER_ACCESS_KEY_ID=replace-with-fonoster-access-key-id
PSTN_BRIDGE_FONOSTER_API_KEY=replace-with-fonoster-api-key
