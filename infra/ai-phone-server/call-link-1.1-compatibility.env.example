# Call Link compatibility profile for a SEPARATE Wujie AI 1.1 server instance.
# This is a reference input only.  Copying it does not start a container and
# does not include API keys, database passwords, LiveKit credentials or model
# credentials.  Keep the real runtime env outside the repository with mode 0600.

# Must match this 1.1 server's independent deployment identity exactly.
API_RESULT_SYNC_DEPLOYMENT_ID=wujie-1-1-call-link
CALL_LINK_1_0_COMPATIBILITY_ENABLED=true
CALL_LINK_1_0_COMPATIBILITY_DEPLOYMENT_ID=wujie-1-1-call-link
CALL_LINK_1_0_COMPATIBILITY_PROFILE=call_link_only
CALL_PROVIDER_POLICY=call_link_only

# Preserve the final 1.0 translation Worker behavior in this 1.1 instance.
# Do not enable unverified product paths merely because the Worker is present.
WUJIE_AI_TRANSLATION_AGENT_ENABLED=true
WUJIE_AI_AGENT_CALL_WORKER_ENABLED=false
WUJIE_AI_VOICE_AGENT_ENABLED=false
WUJIE_AI_AIR_DEVICE_GATEWAY_ENABLED=false
WUJIE_AI_SRT_INGRESS_ENABLED=false

# Deployment operator requirements, deliberately not executable here:
# - unique 1.1 data directory, database identity and secret files;
# - unique container/project prefix and non-conflicting bound ports;
# - no mount, symlink or copied credential file from the frozen 1.0 server;
# - retain existing Call Link host/guest whitelist and do not enable Web Guest,
#   Air780 or PSTN paths as a side effect of this compatibility profile.
