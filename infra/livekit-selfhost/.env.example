# Copy this file to infra/livekit-selfhost/.env and replace every value.
# Do not commit the copied .env file or rendered generated/ directory.

LIVEKIT_DOMAIN=livekit.qkxy.cn
LIVEKIT_TURN_DOMAIN=turn-livekit.qkxy.cn
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret-at-least-32-chars

LIVEKIT_IMAGE=livekit/livekit-server:latest
LIVEKIT_REDIS_IMAGE=redis:7-alpine
LIVEKIT_CADDY_IMAGE=caddy:2-alpine

LIVEKIT_HTTP_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_PORT_START=50000
LIVEKIT_RTC_PORT_END=60000
LIVEKIT_TURN_UDP_PORT=3478

# Optional. Prefer the official LiveKit generator for TURN/TLS on port 443.
LIVEKIT_ENABLE_TURN_TLS=false
LIVEKIT_TURN_TLS_PORT=5349
LIVEKIT_TURN_TLS_CERT_FILE=
LIVEKIT_TURN_TLS_KEY_FILE=
