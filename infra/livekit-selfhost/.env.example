# Copy this file to infra/livekit-selfhost/.env and replace every value.
# Do not commit the copied .env file or rendered generated/ directory.

LIVEKIT_DOMAIN=livekit.qkxy.cn
LIVEKIT_TURN_DOMAIN=turn-livekit.qkxy.cn
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret-at-least-32-chars
LIVEKIT_WEBHOOK_URL=https://api.qkxy.cn/webhooks/livekit
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=replace-with-livekit-outbound-trunk-id
LIVEKIT_SIP_INBOUND_ENABLED=false
LIVEKIT_SIP_INBOUND_TRUNK_ID=
LIVEKIT_SIP_INBOUND_DEDICATED_TRUNK=false
LIVEKIT_SIP_INBOUND_DISPLAY_NUMBER=

# Reviewed linux/amd64 digest for the v1.13.3 compatibility profile.
LIVEKIT_IMAGE=livekit/livekit-server:v1.13.3@sha256:8ef3ee244ded8477d5b40d9dff4b084e1809a9fa0e4d9ed8d29943b3c6322998
LIVEKIT_SIP_IMAGE=livekit/sip:v1.7.0@sha256:replace-with-livekit-sip-digest
# Leave Egress disabled until its target-architecture image is probed in staging.
LIVEKIT_EGRESS_ENABLED=false
LIVEKIT_EGRESS_IMAGE=livekit/egress:replace-with-egress-tag@sha256:replace-with-egress-digest
LIVEKIT_INGRESS_ENABLED=false
LIVEKIT_INGRESS_IMAGE=livekit/ingress:replace-with-ingress-tag@sha256:replace-with-ingress-digest
LIVEKIT_REDIS_IMAGE=redis:7.4.7-alpine@sha256:replace-with-redis-digest
LIVEKIT_CADDY_IMAGE=caddy:2.10.2-alpine@sha256:replace-with-caddy-digest

LIVEKIT_HTTP_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_PORT_START=50000
LIVEKIT_RTC_PORT_END=60000
LIVEKIT_TURN_UDP_PORT=3478
LIVEKIT_SIP_PORT=5060
LIVEKIT_SIP_RTP_PORT_START=10000
LIVEKIT_SIP_RTP_PORT_END=20000
LIVEKIT_SIP_HEALTH_PORT=7888
LIVEKIT_SIP_PROMETHEUS_PORT=6788
LIVEKIT_EGRESS_HEALTH_PORT=7981
LIVEKIT_EGRESS_PROMETHEUS_PORT=6790
LIVEKIT_EGRESS_FILE_MAX_DURATION=2h
LIVEKIT_EGRESS_S3_BUCKET=
LIVEKIT_EGRESS_S3_REGION=
LIVEKIT_EGRESS_S3_ENDPOINT=
LIVEKIT_EGRESS_S3_ACCESS_KEY=
LIVEKIT_EGRESS_S3_SECRET_KEY=
LIVEKIT_EGRESS_S3_SSE=AES256
LIVEKIT_EGRESS_S3_KMS_KEY_ID=
LIVEKIT_EGRESS_OBJECT_PREFIX=recordings
LIVEKIT_EGRESS_MAX_RETENTION_DAYS=30
LIVEKIT_EGRESS_ARTIFACT_WORKER_ENABLED=false
LIVEKIT_EGRESS_ARTIFACT_BATCH_SIZE=4
LIVEKIT_EGRESS_ARTIFACT_RECOVERY_INTERVAL_SECONDS=60
LIVEKIT_INGRESS_HEALTH_PORT=7982
LIVEKIT_INGRESS_PROMETHEUS_PORT=6791
LIVEKIT_INGRESS_RTMP_PORT=1935
LIVEKIT_INGRESS_WHIP_PORT=8080
LIVEKIT_INGRESS_HTTP_RELAY_PORT=9090
LIVEKIT_INGRESS_REQUEST_TIMEOUT_SECONDS=10
LIVEKIT_INGRESS_MAX_ACTIVE_PER_SESSION=1
LIVEKIT_INGRESS_MAX_ACTIVE_TOTAL=8
LIVEKIT_INGRESS_POLICY_VERSION=external-media-v1
LIVEKIT_INGRESS_URL_INPUT_ENABLED=false
LIVEKIT_INGRESS_PULL_URL_HOSTS=
LIVEKIT_INGRESS_PULL_NETWORK_POLICY_ENFORCED=false
LIVEKIT_INGRESS_SOURCE_PREFLIGHT_TIMEOUT_MS=3000
LIVEKIT_INGRESS_SOURCE_MAX_REDIRECTS=2

# Optional. Prefer the official LiveKit generator for TURN/TLS on port 443.
LIVEKIT_ENABLE_TURN_TLS=false
LIVEKIT_TURN_TLS_PORT=5349
LIVEKIT_TURN_TLS_CERT_FILE=
LIVEKIT_TURN_TLS_KEY_FILE=
