{
  "schemaVersion": 1,
  "environment": "staging",
  "topologyFile": "infra/platform-ha/topology.json",
  "capacityResultFile": "outputs/platform-capacity/latest.json",
  "safety": {
    "acknowledgement": "WUJIE_POSTGRES_RESILIENCE_STAGING_ONLY",
    "sourceDatabase": "ai_phone_staging",
    "restoreDatabase": "ai_phone_restore_drill_01",
    "tlsMode": "verify-full",
    "allowAutomaticFailover": true,
    "allowRestoreTargetCreation": true,
    "gracefulDrainSeconds": 30
  },
  "objectives": { "maxRpoSeconds": 300, "maxRtoSeconds": 120 },
  "ha": {
    "mode": "patroni_etcd",
    "nodes": [
      { "hostId": "db-a", "failureDomain": "zone-a" },
      { "hostId": "db-b", "failureDomain": "zone-b" }
    ],
    "dcsVoters": 3,
    "dcsFailureDomains": ["zone-a", "zone-b", "zone-c"],
    "commands": {
      "baseline": {
        "file": "/replace/bin/node",
        "args": ["scripts/run_patroni_ha_provider.mjs", "baseline", "--json"],
        "environmentKeys": ["PATRONI_HA_PROVIDER_CONFIG_FILE", "PGSERVICEFILE", "PGPASSFILE", "PGSSLROOTCERT", "PATRONI_ETCD3_USERNAME", "PATRONI_ETCD3_PASSWORD", "HA_CONTROLLER_TOKEN"],
        "timeoutSeconds": 60
      },
      "triggerFailover": {
        "file": "/replace/bin/node",
        "args": ["scripts/run_patroni_ha_provider.mjs", "trigger-failover", "--json"],
        "environmentKeys": ["PATRONI_HA_PROVIDER_CONFIG_FILE", "PGSERVICEFILE", "PGPASSFILE", "PGSSLROOTCERT", "PATRONI_ETCD3_USERNAME", "PATRONI_ETCD3_PASSWORD", "HA_CONTROLLER_TOKEN"],
        "timeoutSeconds": 300
      },
      "verifyFencing": {
        "file": "/replace/bin/node",
        "args": ["scripts/run_patroni_ha_provider.mjs", "verify-fencing", "--json"],
        "environmentKeys": ["PATRONI_HA_PROVIDER_CONFIG_FILE", "PGSERVICEFILE", "PGPASSFILE", "PGSSLROOTCERT", "PATRONI_ETCD3_USERNAME", "PATRONI_ETCD3_PASSWORD"],
        "timeoutSeconds": 120
      },
      "verifyEndpoint": {
        "file": "/replace/bin/node",
        "args": ["scripts/run_patroni_ha_provider.mjs", "verify-endpoint", "--json"],
        "environmentKeys": ["PATRONI_HA_PROVIDER_CONFIG_FILE", "PGSERVICEFILE", "PGPASSFILE", "PGSSLROOTCERT", "PATRONI_ETCD3_USERNAME", "PATRONI_ETCD3_PASSWORD"],
        "timeoutSeconds": 120
      },
      "rebuildOldPrimary": {
        "file": "/replace/bin/node",
        "args": ["scripts/run_patroni_ha_provider.mjs", "rebuild-old-primary", "--json"],
        "environmentKeys": ["PATRONI_HA_PROVIDER_CONFIG_FILE", "PATRONI_ETCD3_USERNAME", "PATRONI_ETCD3_PASSWORD", "HA_CONTROLLER_TOKEN"],
        "timeoutSeconds": 1800
      }
    }
  },
  "wal": {
    "mode": "wal_g_object_storage",
    "targetClass": "off_host_object_storage",
    "retentionDays": 30,
    "requireEncryptionInTransit": true,
    "requireEncryptionAtRest": true,
    "requireImmutability": true,
    "commands": {
      "createBaseBackup": {
        "file": "/replace/bin/node",
        "args": ["scripts/run_walg_backup_provider.mjs", "create-base-backup", "--json"],
        "environmentKeys": ["WALG_BACKUP_PROVIDER_CONFIG_FILE", "WALG_S3_PREFIX", "AWS_REGION", "AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY", "AWS_SESSION_TOKEN", "AWS_ENDPOINT", "AWS_S3_FORCE_PATH_STYLE", "AWS_S3_CA_CERT_FILE", "WALG_LIBSODIUM_KEY", "OBJECT_STORAGE_CONTROL_TOKEN"],
        "timeoutSeconds": 3600
      },
      "verifyArchive": {
        "file": "/replace/bin/node",
        "args": ["scripts/run_walg_backup_provider.mjs", "verify-archive", "--json"],
        "environmentKeys": ["WALG_BACKUP_PROVIDER_CONFIG_FILE", "PGSERVICEFILE", "PGPASSFILE", "PGSSLROOTCERT", "WALG_S3_PREFIX", "AWS_REGION", "AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY", "AWS_SESSION_TOKEN", "AWS_ENDPOINT", "AWS_S3_FORCE_PATH_STYLE", "AWS_S3_CA_CERT_FILE", "WALG_LIBSODIUM_KEY", "OBJECT_STORAGE_CONTROL_TOKEN"],
        "timeoutSeconds": 300
      },
      "restoreOffHost": {
        "file": "/replace/bin/node",
        "args": ["scripts/run_walg_backup_provider.mjs", "restore-off-host", "--json"],
        "environmentKeys": ["WALG_BACKUP_PROVIDER_CONFIG_FILE", "WALG_S3_PREFIX", "AWS_REGION", "AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY", "AWS_SESSION_TOKEN", "AWS_ENDPOINT", "AWS_S3_FORCE_PATH_STYLE", "AWS_S3_CA_CERT_FILE", "WALG_LIBSODIUM_KEY", "POSTGRES_RECOVERY_CONTROL_TOKEN"],
        "timeoutSeconds": 7200
      },
      "verifyRestore": {
        "file": "/replace/bin/node",
        "args": ["scripts/run_walg_backup_provider.mjs", "verify-restore", "--json"],
        "environmentKeys": ["WALG_BACKUP_PROVIDER_CONFIG_FILE", "PGSERVICEFILE", "PGPASSFILE", "PGSSLROOTCERT", "POSTGRES_RECOVERY_CONTROL_TOKEN"],
        "timeoutSeconds": 600
      }
    }
  }
}
