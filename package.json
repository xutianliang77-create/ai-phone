    "test": "npm run test:scripts && npm run test --workspaces --if-present",
    "test:scripts": "vitest run scripts",
    "test:communication-contract-python": "python3 packages/contracts/python/test_communication_contract.py",
    "test:communication-contract-flutter": "cd apps/mobile && flutter test test/communication_contract_golden_test.dart",
