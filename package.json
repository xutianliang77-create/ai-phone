    "list:livekit-sbom-images": "node scripts/list_livekit_sbom_images.mjs",
    "check:platform-topology": "node scripts/check_platform_topology.mjs",
    "check:platform-capacity": "node scripts/check_platform_capacity_result.mjs",
    "platform:mixed-load": "node scripts/run_platform_mixed_load.mjs",
