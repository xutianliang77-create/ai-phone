    "check:lines": "node tools/check-file-size.mjs",
    "check:source-build": "node scripts/check_source_build_readiness.mjs",
    "check:wujie-dual-version-ci": "node scripts/check_wujie_dual_version_ci.mjs",
    "storage:migrate-json": "tsx services/api-server/src/infrastructure/storage/sqlite-store-admin.ts migrate-json",
    "storage:check": "tsx services/api-server/src/infrastructure/storage/sqlite-store-admin.ts check",
    "storage:backup": "tsx services/api-server/src/infrastructure/storage/sqlite-store-admin.ts backup",
    "storage:restore": "tsx services/api-server/src/infrastructure/storage/sqlite-store-admin.ts restore",
