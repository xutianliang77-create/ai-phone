    "speaker:evaluate-suite": "node scripts/run_speaker_diarization_suite_eval.mjs",
    "speaker:generate-suite-inputs": "node scripts/generate_speaker_eval_inputs.mjs",
    "speaker:run-service-suite": "node scripts/run_speaker_service_suite.mjs",
    "check:realtime-speaker-turn": "node scripts/realtime_speaker_turn_smoke.mjs",
    "check:mobile-offline-end": "cd apps/mobile && flutter test test/realtime_controller_offline_end_test.dart test/realtime_controller_start_cancel_test.dart test/realtime_api_client_test.dart",
