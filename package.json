    "check:agent-call-worker": "node scripts/check_agent_call_worker_readiness.mjs",
    "check:pstn-bridge-audio": "node scripts/check_pstn_bridge_audio_readiness.mjs",
    "check:pstn-bridge-media-ingest": "node scripts/check_pstn_bridge_media_ingest_readiness.mjs",
    "check:pstn-provider-media-event": "node scripts/check_pstn_provider_media_event_readiness.mjs",
    "check:pstn-provider-status-event": "node scripts/check_pstn_provider_status_event_readiness.mjs",
    "check:translation-worker-pstn-audio-sink": "node scripts/check_translation_worker_pstn_audio_sink_readiness.mjs",
    "check:pstn-internal-media-loop": "node scripts/check_pstn_internal_media_loop_readiness.mjs",
    "check:diagnostics-alerting": "node scripts/check_diagnostics_alerting_readiness.mjs",
    "check:realtime-observability": "node scripts/check_realtime_observability_assets.mjs",
    "check:domestic-payment-callbacks": "node scripts/check_domestic_payment_callbacks_readiness.mjs",
    "check:tts-provider": "node scripts/check_tts_provider_readiness.mjs",
    "check:translation-provider": "node scripts/check_lmstudio_translation_provider.mjs",
    "check:model-routing": "node scripts/check_model_routing_config.mjs",
    "render:model-routing-env": "node scripts/render_model_routing_env.mjs",
    "deploy:beelink-model-services": "bash scripts/deploy_beelink_model_services.sh",
    "deploy:beelink-app-services": "bash scripts/deploy_beelink_app_services.sh deploy",
    "status:beelink-app-services": "bash scripts/deploy_beelink_app_services.sh status",
    "deploy:beelink-core-candidate": "bash scripts/deploy_beelink_core_candidate.sh deploy",
    "status:beelink-core-candidate": "bash scripts/deploy_beelink_core_candidate.sh status",
    "deploy:beelink-tts": "bash scripts/deploy_beelink_voxcpm2_tts_service.sh",
