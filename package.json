    "postgres:check": "npm run postgres:check -w @translation/api-server",
    "postgres:import": "npm run postgres:import -w @translation/api-server",
    "postgres:audit": "npm run postgres:audit -w @translation/api-server",
    "postgres:startup-check": "npm run postgres:startup-check -w @translation/api-server",
    "postgres:upgrade-evidence": "npm run postgres:upgrade-evidence -w @translation/api-server",
    "check:postgres-primary-cutover": "node scripts/check_postgres_primary_cutover.mjs --release",
    "ios:nemotron:services": "bash scripts/ios_nemotron_start_services.sh",
    "ios:nemotron:smoke": "bash scripts/ios_nemotron_mvp_smoke.sh",
    "ios:nemotron:status": "node scripts/ios_nemotron_mvp_status.mjs",
    "ios:nemotron:preflight": "bash scripts/ios_nemotron_local_preflight.sh",
    "ios:nemotron:repair-provisioning": "bash scripts/ios_nemotron_repair_provisioning.sh",
    "ios:nemotron:wait-device": "bash scripts/ios_nemotron_wait_device.sh",
    "ios:nemotron:detect-lan-ip": "node scripts/detect_mac_lan_ip.mjs",
    "ios:nemotron:check-lmstudio": "node scripts/check_lmstudio_translation_provider.mjs",
    "ios:nemotron:run": "bash scripts/ios_nemotron_run_mvp.sh",
    "ios:nemotron:report": "node scripts/ios_nemotron_mvp_report.mjs",
    "ios:vad:stage": "node scripts/download_ios_silero_vad_bundle.mjs --stage",
    "ios:asr:language-ab": "node scripts/run_nemotron_language_ab.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "optionalDependencies": {
    "@ffmpeg-installer/linux-x64": "4.1.0"
  }
}
