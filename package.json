{
  "name": "ai-phone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "pretest": "npm run build && npm run check:livekit-compatibility",
    "dev:api": "npm run dev -w @translation/api-server",
    "dev:realtime": "npm run dev -w @translation/realtime-gateway",
    "dev:call-link-worker": "bash scripts/start_call_link_translation_worker.sh",
